{
  "name": "pitchup",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "husky",
    "db:generate": "pnpm --filter @pitchup/web db:generate",
    "db:push": "pnpm --filter @pitchup/web db:push",
    "db:migrate": "pnpm --filter @pitchup/web db:migrate",
    "db:studio": "pnpm --filter @pitchup/web db:studio",
    "db:seed": "pnpm --filter @pitchup/web db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @pitchup/web test:e2e",
    "test:mobile": "pnpm --filter @pitchup/mobile test",
    "test:all": "pnpm test && pnpm test:mobile && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    },
    "patchedDependencies": {
      "@react-native/codegen@0.76.0": "patches/@react-native__codegen@0.76.0.patch",
      "react-native-maps@1.29.11": "patches/react-native-maps@1.29.11.patch"
    }
  }
}
