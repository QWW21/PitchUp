# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Variables marked OPTIONAL become required in the epic that introduces the
# integration; until then the app runs without them.

# ─── Database ────────────────────────────────────────────────────────────────
# Add ?connection_limit=5&pool_timeout=10 in production to bound the pool.
DATABASE_URL="postgresql://postgres:password@localhost:5432/pitchup_dev?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Seed ────────────────────────────────────────────────────────────────────
# OPTIONAL. Seed falls back to "Admin1234!" and prints a warning when unset.
ADMIN_PASSWORD=""

# ─── Stripe (OPTIONAL until E05 — payments) ──────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Uploads are disabled until all three are set. The secret signs direct
# client uploads and must never reach a client bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Resend (transactional email) ────────────────────────────────────────────
# Without a key, emails are logged to the server console instead of sent, so
# the signup flow is fully testable locally. EMAIL_FROM must use a domain
# verified in Resend, or delivery is rejected.
RESEND_API_KEY=""
EMAIL_FROM="PitchUp <noreply@pitchup.ro>"""

# ─── Twilio (SMS — phone verification) ───────────────────────────────────────
# All three are needed before any SMS is sent; with any missing, codes are
# logged to the server console instead and phoneVerified stays false.
#
# Self-managed OTP over plain Twilio SMS (ticket E02-10 Option B), not Twilio
# Verify: PitchUp generates, hashes and checks the code itself, so phone
# verification stays testable without a live Twilio account.
#
# Every SMS is billed (~$0.04 to Romania). Sends are capped at 3 per phone
# number per hour, independent of the caller's IP.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Firebase Cloud Messaging (OPTIONAL until E13 — push) ────────────────────
FCM_SERVER_KEY=""

# ─── Maps (OPTIONAL until E03 — discover map view) ───────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
