# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Variables marked OPTIONAL become required in the epic that introduces the
# integration; until then the app runs without them.

# ─── Database ────────────────────────────────────────────────────────────────
# Add ?connection_limit=5&pool_timeout=10 in production to bound the pool.
DATABASE_URL="postgresql://postgres:password@localhost:5432/pitchup_dev?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL. How many proxies in front of the app add to X-Forwarded-For; the
# client IP for the per-IP rate limits is read this many entries from the
# right. 1 (the default) on Vercel or behind one nginx; 2 behind a CDN and
# nginx. An integer of at least 1.
TRUSTED_PROXY_HOPS=""

# ─── Seed ────────────────────────────────────────────────────────────────────
# OPTIONAL. Seed falls back to "Admin1234!" and prints a warning when unset.
ADMIN_PASSWORD=""

# ─── Stripe (OPTIONAL until E05 — payments) ──────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Publishable key (pk_test_… in test mode). With all three Stripe values blank,
# bookings use the built-in test payments (dev, or ALLOW_TEST_HOOKS=1).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Uploads are disabled until all three are set. The secret signs direct
# client uploads and must never reach a client bundle.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Resend (transactional email) ────────────────────────────────────────────
# Without a key, emails are logged to the server console instead of sent, so
# the signup flow is fully testable locally. EMAIL_FROM must use a domain
# verified in Resend, or delivery is rejected.
RESEND_API_KEY=""
EMAIL_FROM="PitchUp <noreply@pitchup.ro>"

# ─── Twilio (SMS — phone verification) ───────────────────────────────────────
# All three are needed before any SMS is sent; with any missing, codes are
# logged to the server console instead and phoneVerified stays false.
#
# Self-managed OTP over plain Twilio SMS (ticket E02-10 Option B), not Twilio
# Verify: PitchUp generates, hashes and checks the code itself, so phone
# verification stays testable without a live Twilio account.
#
# Every SMS is billed (~$0.04 to Romania). Sends are capped at 3 per phone
# number per hour, independent of the caller's IP.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Optional: a Twilio Verify service (VA...). Then Twilio makes, sends and checks
# the phone codes, which is the only way a trial account can send them.
TWILIO_VERIFY_SERVICE_SID=""

# ─── Firebase Cloud Messaging (OPTIONAL until E13 — push) ────────────────────
FCM_SERVER_KEY=""

# ─── Maps (OPTIONAL until E03 — discover map view) ───────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# OPTIONAL. Server-only key with the Geocoding API, used when a venue's
# address is saved without map coordinates (E09-02). Never NEXT_PUBLIC.
GOOGLE_MAPS_API_KEY=""

# ─── Scheduled jobs (E11-10) ─────────────────────────────────────────────────
# OPTIONAL. Bearer token for /api/v1/cron/auto-complete (Vercel Cron sends it).
# At least 16 characters; without it the job refuses every call.
CRON_SECRET=""

# ─── Push notifications (E13-02) ─────────────────────────────────────────────
# OPTIONAL. A Firebase service account (Project settings → Service accounts →
# Generate new private key). Without these, push is skipped; email and SMS
# still go. Paste the private key on one line with 
 for line breaks.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─── Google sign-in ───────────────────────────────────────────────────────────
# OPTIONAL. OAuth clients from Google Cloud → APIs & Services → Clients, in the
# Firebase project. GOOGLE_CLIENT_ID is the Web client: it drives the web
# button and is the audience of the app's ID tokens. Without it, the Google
# buttons are hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_IOS_CLIENT_ID=""

# ─── Error monitoring (Sentry) ────────────────────────────────────────────────
# OPTIONAL. The pitchup-web project's DSN (Project settings → Client Keys). Not
# a secret. Without it nothing is reported. ENVIRONMENT tells production from
# staging in Sentry (defaults to NODE_ENV).
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
