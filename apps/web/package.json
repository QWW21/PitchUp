{
  "name": "@pitchup/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "preview": "cross-env NEXT_DIST_DIR=.next-preview next build && cross-env NEXT_DIST_DIR=.next-preview next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:evidence": "cross-env EVIDENCE=1 playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@pitchup/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@react-google-maps/api": "^2.20.8",
    "@stripe/react-stripe-js": "3.11.0",
    "@stripe/stripe-js": "7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "stripe": "18.5.0",
    "twilio": "^6.1.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7",
    "postcss": "^8.4.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5"
  }
}
