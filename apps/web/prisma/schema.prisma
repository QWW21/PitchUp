// PitchUp — Prisma schema
// Reference: PRD.md §13 (Data Models), ticket E01-02
// All DateTime values are stored in UTC and rendered in the user's local tz.

generator client {
  provider = "prisma-client-js"
  // No custom `output`: under pnpm the client must be generated next to the
  // installed @prisma/client package in the store, not into apps/web/node_modules.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  MANAGER
  ADMIN
}

/// DRAFT while the manager onboards (E09), PENDING once submitted for an
/// admin's approval, ACTIVE when approved. Only ACTIVE venues are public.
enum CompanyStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
}

/// How a venue is paid — C-8.
enum VenuePaymentMode {
  ONLINE
  ONLINE_OR_VENUE
  VENUE
}

enum BookingPaymentMethod {
  ONLINE
  VENUE_REFUND_DEPOSIT
  VENUE_DEPOSIT_TOWARDS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DisputeStatus {
  NONE
  OPEN
  RESOLVED_PLAYER
  RESOLVED_MANAGER
}

enum ModerationStatus {
  APPROVED
  PENDING
  REMOVED
}

enum SurfaceType {
  NATURAL_GRASS
  ARTIFICIAL_GRASS
  FUTSAL
}

/// The format the owner recommends (players per team), not a cap: the price
/// is per hour whoever turns up.
enum PitchSize {
  FIVE_A_SIDE
  SIX_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
  CUSTOM
}

enum AmenityType {
  SHOWERS_FREE
  SHOWERS_PAID
  CHANGING_ROOMS
  PARKING_FREE
  PARKING_PAID
  NIGHT_LIGHTING
  BALL_RENTAL_FREE
  BALL_RENTAL_PAID
  REFRESHMENTS
  LOCKERS
  REFEREE
  FIRST_AID
  WHEELCHAIR
  WIFI
}

enum ShirtColour {
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
  WHITE
  BLACK
  PURPLE
}

enum TrustScoreReason {
  BOOKING_COMPLETED
  REVIEW_LEFT
  LATE_CANCEL
  VERY_LATE_CANCEL
  NO_SHOW
  DISPUTE_WON
  MONTHLY_RECOVERY
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER_24H
  BOOKING_REMINDER_2H
  BOOKING_CANCELLED_PLAYER
  BOOKING_CANCELLED_MANAGER
  REFUND_PROCESSED
  NO_SHOW_REPORTED
  /// To admins: a player disputes a no-show (E06-04).
  DISPUTE_OPENED
  PENALTY_CHARGED
  DISPUTE_RESOLVED
  REVIEW_LEFT
  MANAGER_REPLIED
  /// To admins: someone reported a review (E07-04).
  REVIEW_REPORTED
  /// To admins: a venue finished onboarding and waits for approval (E09).
  COMPANY_SUBMITTED
  /// To the manager: their venue was approved, or sent back (E09).
  COMPANY_APPROVED
  COMPANY_REJECTED
  /// To the player: their trust tier went up or down (E13).
  TRUST_TIER_CHANGED
  OTP
  PASSWORD_RESET
}

/// Why a review was reported. PRD §11.3.
enum ReviewReportCategory {
  SPAM
  OFFENSIVE
  IRRELEVANT
  FAKE
}

enum CancelledBy {
  PLAYER
  MANAGER
  ADMIN
  SYSTEM
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String    @unique
  passwordHash      String
  name              String
  profilePhotoUrl   String?
  city              String?
  dateOfBirth       DateTime?
  role              Role      @default(PLAYER)
  trustScore        Int       @default(100)
  stripeCustomerId  String?
  emailVerified     Boolean   @default(false)
  phoneVerified     Boolean   @default(false)
  /// Web sessions (stateless JWTs) issued before this are rejected, so a
  /// password reset signs out every browser. Mobile uses refresh-token
  /// revocation instead.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  /// Why the player deleted their account, if they said (E08-03).
  deletionReason    String?

  company             Company?
  bookings            Booking[]
  reviews             Review[]
  reviewReports       ReviewReport[]
  notifications       Notification[]
  trustScoreEvents    TrustScoreEvent[]
  noShowsReported     NoShow[]             @relation("NoShowReportedByManager")
  noShowsResolved     NoShow[]             @relation("NoShowResolvedByAdmin")
  verificationCodes   VerificationCode[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  deviceTokens        DeviceToken[]

  @@index([role])
  @@index([city])
  notificationPreference NotificationPreference?
}

model Company {
  id                   String           @id @default(cuid())
  ownerId              String           @unique
  name                 String
  description          String?
  logoUrl              String?
  websiteUrl           String?
  facebookUrl          String?
  instagramUrl         String?
  /// Contact and address are filled in steps 2 and 3 of onboarding (E09),
  /// so a DRAFT company may not have them yet. ACTIVE ones always do.
  phone                String?
  email                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  county               String?
  country              String           @default("RO")
  postalCode           String?
  lat                  Float?
  lng                  Float?
  workingHours         Json?
  stripeAccountId      String?
  /// Mirrored from Stripe Connect's account.updated webhook (E05-08).
  stripeChargesEnabled Boolean          @default(false)
  stripePayoutsEnabled Boolean          @default(false)
  /// C-8: how players pay, and the online deposit (0–50%) when they pay at the venue.
  paymentMode          VenuePaymentMode @default(ONLINE)
  depositPercent       Int              @default(20)
  status               CompanyStatus    @default(DRAFT)
  /// When the manager finished onboarding, and when an admin decided.
  submittedAt          DateTime?
  reviewedAt           DateTime?
  /// Why an admin sent it back; cleared when resubmitted.
  rejectionReason      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pitches Pitch[]

  @@index([city])
  @@index([status])
}

model Pitch {
  id                 String      @id @default(cuid())
  companyId          String
  name               String
  description        String?
  surfaceType        SurfaceType
  size               PitchSize
  widthMeters        Float?
  lengthMeters       Float?
  isActive           Boolean     @default(true)
  coverPhotoIndex    Int         @default(0)
  /// Hours, in halves: 1, 1.5, 2… (a booking is any half hour between the two).
  minBookingHours    Float       @default(1)
  maxBookingHours    Float       @default(4)
  advanceBookingDays Int         @default(60)
  /// One price per hour at any time of day. No peak pricing.
  hourlyRate         Decimal     @db.Decimal(10, 2)
  /// Shirts are always free; the inventory says which colours there are.
  hasShirts          Boolean     @default(false)
  /// The pitch's own week (E10-10), within the venue's hours; null follows the venue.
  workingHours       Json?
  /// Soft delete (E10-05): hidden everywhere, kept for its bookings and reviews.
  deletedAt          DateTime?
  /// The lowest trust score that may book (E12-06): a tier's lower bound; 0 = anyone allowed to book.
  minTrustScore      Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photos         PitchPhoto[]
  amenities      PitchAmenity[]
  shirtInventory ShirtInventory[]
  bookings       Booking[]
  reviews        Review[]
  exceptions     PitchException[]

  @@index([companyId])
  @@index([isActive])
}

/// A date the pitch is closed despite its normal hours (holiday, maintenance). E04-03.
model PitchException {
  id      String   @id @default(cuid())
  pitchId String
  /// Venue-local calendar date.
  date    DateTime @db.Date
  reason  String?

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@unique([pitchId, date])
}

model PitchPhoto {
  id                 String   @id @default(cuid())
  pitchId            String
  url                String
  cloudinaryPublicId String
  order              Int      @default(0)
  createdAt          DateTime @default(now())

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@index([pitchId, order])
}

model PitchAmenity {
  id          String      @id @default(cuid())
  pitchId     String
  amenityType AmenityType
  isPaid      Boolean     @default(false)
  price       Decimal?    @db.Decimal(10, 2)

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@unique([pitchId, amenityType])
  @@index([pitchId])
}

/// Shirt sets a pitch can lend, by colour. One set dresses one team.
model ShirtInventory {
  id       String      @id @default(cuid())
  pitchId  String
  colour   ShirtColour
  quantity Int         @default(0)

  pitch Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@unique([pitchId, colour])
  @@index([pitchId])
}

model Booking {
  id                    String               @id @default(cuid())
  pitchId               String
  playerId              String
  startTime             DateTime
  endTime               DateTime
  teamCount             Int
  teamsData             Json?
  noteToManager         String?
  status                BookingStatus        @default(PENDING)
  cancelledBy           CancelledBy?
  cancelledAt           DateTime?
  cancellationReason    String?
  pitchRateSnapshot     Decimal              @db.Decimal(10, 2)
  /// Free shirt sets lent for this booking: teamCount - 1 when asked for, else 0.
  shirtSets             Int                  @default(0)
  /// PitchUp's commission, kept from the venue's payout (8%). Not added to
  /// what the player pays.
  platformFee           Decimal              @db.Decimal(10, 2)
  /// What the player pays: the pitch rental, hourly rate × hours.
  totalAmount           Decimal              @db.Decimal(10, 2)
  refundAmount          Decimal?             @db.Decimal(10, 2)
  /// "stripe", or "test" for the built-in test payments used without Stripe keys.
  paymentProvider       String?
  /// The provider's payment id (a Stripe PaymentIntent, or test_pi_… in test mode).
  stripePaymentIntentId String?              @unique
  stripeRefundId        String?
  paidAt                DateTime?
  /// The card that paid, for the booking detail (E06-02); null in test mode.
  cardBrand             String?
  cardLast4             String?
  /// C-8: online in full, or at the venue with a deposit (refunded, or counted).
  paymentMethod         BookingPaymentMethod @default(ONLINE)
  /// Charged online as the deposit; null when paid online in full.
  depositAmount         Decimal?             @db.Decimal(10, 2)
  /// Paid to the venue on the day; 0 when paid online.
  dueAtVenue            Decimal              @default(0) @db.Decimal(10, 2)
  /// The manager confirmed the player came (C-8).
  attendedAt            DateTime?
  /// The 24-hour reminder went out (E13-04).
  reminderSentAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  pitch  Pitch @relation(fields: [pitchId], references: [id], onDelete: Restrict)
  player User  @relation(fields: [playerId], references: [id], onDelete: Restrict)

  noShow           NoShow?
  review           Review?
  trustScoreEvents TrustScoreEvent[]
  statusEvents     BookingStatusEvent[]

  @@index([pitchId, startTime])
  @@index([playerId])
  @@index([status])
}

/// Every status a booking has been in, oldest first: the detail page's timeline (E06-02).
model BookingStatusEvent {
  id        String        @id @default(cuid())
  bookingId String
  status    BookingStatus
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

/// Stripe webhook events already handled, so a redelivered event is a no-op (E05-08).
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model NoShow {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  reportedByManagerId String
  reason              String?
  penaltyAmount       Decimal       @db.Decimal(10, 2)
  disputeStatus       DisputeStatus @default(NONE)
  disputeText         String?
  disputeEvidenceUrls Json?
  resolvedByAdminId   String?
  resolvedAt          DateTime?
  /// What the admin decided and why (E12-04); the player sees it.
  resolution          String?
  createdAt           DateTime      @default(now())

  booking           Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reportedByManager User    @relation("NoShowReportedByManager", fields: [reportedByManagerId], references: [id], onDelete: Restrict)
  resolvedByAdmin   User?   @relation("NoShowResolvedByAdmin", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([disputeStatus])
  @@index([reportedByManagerId])
}

model Review {
  id               String           @id @default(cuid())
  bookingId        String           @unique
  pitchId          String
  playerId         String
  rating           Int
  text             String?
  photoUrls        Json?
  isAnonymous      Boolean          @default(false)
  managerReply     String?
  managerRepliedAt DateTime?
  isFlagged        Boolean          @default(false)
  flagReason       String?
  moderationStatus ModerationStatus @default(APPROVED)
  /// Deleted by its author (E06-05): hidden everywhere, kept for the record.
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  booking Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pitch   Pitch          @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  player  User           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  reports ReviewReport[]

  @@index([pitchId])
  @@index([playerId])
  @@index([moderationStatus])
}

/// A phone that may receive push notifications (E08-10). One row per token:
/// a token that signs in as someone else moves to that user.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One user's report of one review (E07-04). The review stays visible;
/// it is flagged for an admin to decide (E15).
model ReviewReport {
  id         String               @id @default(cuid())
  reviewId   String
  reporterId String
  category   ReviewReportCategory
  detail     String?
  createdAt  DateTime             @default(now())

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  sentPush  Boolean          @default(false)
  sentEmail Boolean          @default(false)
  sentSms   Boolean          @default(false)
  /// Set when the email, SMS and push for it were attempted (E13): an outbox.
  deliveredAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([deliveredAt, createdAt])
}

/// How a person wants to be told (E13-07). No row means the defaults.
model NotificationPreference {
  id            String             @id @default(cuid())
  userId        String             @unique
  pushEnabled   Boolean            @default(true)
  emailEnabled  Boolean            @default(true)
  smsEnabled    Boolean            @default(false)
  disabledTypes NotificationType[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustScoreEvent {
  id               String           @id @default(cuid())
  userId           String
  delta            Int
  reason           TrustScoreReason
  relatedBookingId String?
  createdAt        DateTime         @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedBooking Booking? @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Which channel a verification code was sent over. Email and phone codes
/// live in one table but must never be interchangeable: a code texted to a
/// phone must not verify an email address.
enum VerificationChannel {
  EMAIL
  PHONE
}

/// A short-lived code sent to confirm an email address or phone number. E02-08.
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String
  channel   VerificationChannel
  /// SHA-256 of the 6-digit code. A leaked database must not grant access.
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong guesses so far; the code is burned past a threshold.
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([expiresAt])
}

/// A single-use password reset grant. E02-11.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the token. Only the emailed link carries the plaintext, so
  /// a leaked database cannot be used to take over accounts.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Long-lived mobile session token. Web uses a NextAuth cookie instead. E02-08.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 of the token. Only the client ever holds the plaintext.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Set when this token is rotated, pointing at its successor, so reuse of
  /// an already-rotated token can be detected as theft.
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model City {
  id      String @id @default(cuid())
  name    String @unique
  county  String
  country String @default("RO")

  @@index([country])
}
