+++ b/android/src/main/java/com/facebook/react/uimanager/ViewManagerWithGeneratedInterface.java
@@ -0,0 +1,11 @@
+package com.facebook.react.uimanager;
+
+/**
+ * Marker interface that react-native-maps' generated view-manager interfaces extend.
+ *
+ * React Native only started shipping this class after 0.76, so compiling
+ * react-native-maps 1.29.11 against RN 0.76 fails with "cannot find symbol".
+ * It carries no members, so declaring it here is equivalent to the upstream one.
+ * Remove this patch once the app is on an RN version that provides it.
+ */
+public interface ViewManagerWithGeneratedInterface {}
